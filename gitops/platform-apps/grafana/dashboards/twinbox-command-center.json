      "targets": [
        {
          "refId": "A",
          "expr": "(count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})) or vector(0)",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
