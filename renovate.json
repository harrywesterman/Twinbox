{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Amsterdam",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "ignoreTests": false,
  "ignoreUnstable": true,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 4,
  "assignees": ["harrywesterman"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "assignees": ["harrywesterman"],
    "schedule": [],
    "minimumReleaseAge": null
  },
  "enabledManagers": [
    "argocd",
    "dockerfile",
    "docker-compose",
    "npm",
    "github-actions",
    "custom.regex"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/gitops/apps/.*\\.yaml$/",
      "/gitops/optional-apps/.*\\.yaml$/",
      "/gitops/databases/.*\\.yaml$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": ["/(^|/)Dockerfile$/", "/(^|/)Dockerfile\\.[a-z]+$/"]
  },
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-compose\\.ya?ml$/"]
  },
  "npm": {
    "managerFilePatterns": ["/(^|\\/)package\\.json$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "PINNED_*_VERSION vars in config/pinned-defaults.sh",
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "matchStringsStrategy": "any",
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_TALOS_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_OPENTOFU_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "opentofu/opentofu"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_K9S_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "derailed/k9s",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_KUBECTL_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_HELM_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "helm/helm",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_ARGOCD_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "argoproj/argo-cd",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_BESZEL_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "henrygd/beszel",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_NETBIRD_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "netbirdio/netbird",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "github-releases",
      "matchStrings": [
        "PINNED_ADGUARD_HOME_VERSION=(?<currentValue>v?[0-9.]+)"
      ],
      "depNameTemplate": "AdguardTeam/AdGuardHome",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io",
      "matchStrings": ["PINNED_CILIUM_CHART_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "cilium",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudtty.github.io/cloudtty",
      "matchStrings": [
        "PINNED_CLOUDTTY_CHART_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "cloudtty",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.coder.com/v2",
      "matchStrings": ["PINNED_CODER_CHART_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "coder",
      "customType": "regex"
    },
    {
      "managerFilePatterns": ["/(^|/)config/pinned-defaults\\.sh$/"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://codeberg.org",
      "matchStrings": ["PINNED_FORGEJO_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "forgejo/forgejo",
      "customType": "regex"
    },
    {
      "description": "Image tags in gitops/values/*.yaml and gitops/apps/authentik/values.yaml",
      "managerFilePatterns": ["/(^|/)gitops/(values|apps)/.*\\.yaml$/"],
      "matchStringsStrategy": "any",
      "datasourceTemplate": "docker",
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^:\"'\\s]+):(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "customType": "regex"
    },
    {
      "description": "Image tags in gitops/platform-apps/*/workload yamls",
      "managerFilePatterns": [
        "/(^|/)gitops/platform-apps/.+/(deployment|statefulset|daemonset|job|cronjob|redis|valkey|workers|document-converters|manifest|relay-egress)\\.yaml$/"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^:\"'\\s]+):(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "customType": "regex"
    }
  ],
  "hostRules": [
    {
      "description": "codeberg.org container registry (OCI, token auth)",
      "hostType": "docker",
      "matchHost": "codeberg.org",
      "concurrentRequestLimit": 1
    }
  ],
  "packageRules": [
    {
      "description": "Pin typescript to 5.x in eurooffice-file-action: TS 7 (native) lacks the JS compiler API required by @nextcloud/vite-config",
      "matchPackageNames": ["typescript"],
      "matchFileNames": ["categories/apps/steps/install-nextcloud/eurooffice-file-action/package.json"],
      "enabled": false
    },
    {
      "description": "Skip private registry docker.getoutline.com (no public access)",
      "matchDatasources": ["docker"],
      "matchDepNames": ["docker.getoutline.com/**"],
      "enabled": false
    },
    {
      "description": "Group all patches and minors for twinbox/k8s apps into one PR per app",
      "matchDatasources": ["github-releases", "docker", "helm"],
      "groupName": "{{manager}} {{depName}} updates",
      "groupSlug": "{{manager}}-{{depName}}"
    },
    {
      "description": "Schedule manually reviewed updates in the weekly maintenance window",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "schedule": ["before 06:00 on monday"]
    },
    {
      "description": "Keep runtime lock file maintenance manual",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "matchFileNames": ["**/package-lock.json", "!package-lock.json"],
      "groupName": "Runtime lock file maintenance",
      "automerge": false
    },
    {
      "description": "Automerge stable npm development updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "minimumReleaseAge": "14 days",
      "internalChecksFilter": "strict",
      "schedule": ["before 06:00 every weekday"],
      "automerge": true
    },
    {
      "description": "Automerge root tooling lock file maintenance",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "matchFileNames": ["package-lock.json"],
      "groupName": "Root tooling lock file maintenance",
      "schedule": ["before 06:00 on monday"],
      "automerge": true
    },
    {
      "description": "Automerge Verify workflow action digests",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "matchFileNames": [".github/workflows/verify.yml"],
      "schedule": ["before 06:00 every weekday"],
      "automerge": true
    }
  ]
}
