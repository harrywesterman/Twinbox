{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": [
    "argocd",
    "dockerfile",
    "docker-compose",
    "npm",
    "github-actions",
    "regex"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/gitops/apps/.*\\.yaml$/",
      "/gitops/optional-apps/.*\\.yaml$/",
      "/gitops/databases/.*\\.yaml$/"
    ]
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile$/",
      "/(^|/)Dockerfile\\.[a-z]+$/"
    ]
  },
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-compose\\.ya?ml$/"]
  },
  "npm": {
    "managerFilePatterns": ["/(^|\\/)package\\.json$/"]
  },
  "customManagers": [
    {
      "description": "PINNED_*_VERSION vars in config/pinned-defaults.sh",
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "matchStringsStrategy": "any",
      "datasourceTemplate": "github-releases",
      "matchStrings": [
        "PINNED_TALOS_VERSION=(?<currentValue>v?[0-9.]+)"
      ],
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_OPENTOFU_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "opentofu/opentofu"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_K9S_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "derailed/k9s"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_KUBECTL_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "kubernetes/kubernetes"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_HELM_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "helm/helm"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_ARGOCD_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "argoproj/argo-cd"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_BESZEL_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "henrygd/beszel"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_NETBIRD_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "netbirdio/netbird"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "github-releases",
      "matchStrings": ["PINNED_ADGUARD_HOME_VERSION=(?<currentValue>v?[0-9.]+)"],
      "depNameTemplate": "AdguardTeam/AdGuardHome"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io",
      "matchStrings": ["PINNED_CILIUM_CHART_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "cilium/cilium"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://cloudtty.github.io/cloudtty",
      "matchStrings": ["PINNED_CLOUDTTY_CHART_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "cloudtty/cloudtty"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.coder.com/v2",
      "matchStrings": ["PINNED_CODER_CHART_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "coder"
    },
    {
      "fileMatch": ["(^|/)config/pinned-defaults\\.sh$"],
      "datasourceTemplate": "docker",
      "matchStrings": ["PINNED_FORGEJO_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "codeberg.org/forgejo/forgejo"
    },
    {
      "description": "Image tags in gitops/values/*.yaml and gitops/apps/authentik/values.yaml",
      "fileMatch": ["(^|/)gitops/(values|apps)/.*\\.yaml$"],
      "matchStringsStrategy": "any",
      "datasourceTemplate": "docker",
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^:\"'\\s]+):(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "description": "mailuVersion in gitops/values/mailu.yaml",
      "fileMatch": ["(^|/)gitops/values/mailu\\.yaml$"],
      "datasourceTemplate": "docker",
      "matchStrings": ["mailuVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"],
      "depNameTemplate": "ghcr.io/mailu/mailu"
    },
    {
      "description": "Image tags in gitops/platform-apps/*/workload yamls",
      "fileMatch": [
        "(^|/)gitops/platform-apps/.+/(deployment|statefulset|daemonset|job|cronjob|redis|valkey|workers|document-converters|manifest|relay-egress)\\.yaml$"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": ["image:\\s*[\"']?(?<depName>[^:\"'\\s]+):(?<currentValue>[^\"'\\s]+)[\"']?"]
    }
  ],
  "packageRules": [
    {
      "description": "Group all patches and minors for twinbox/k8s apps into one PR per app",
      "matchDatasources": ["github-releases", "docker", "helm"],
      "groupName": "{{manager}} {{depName}} updates",
      "groupSlug": "{{manager}}-{{depName}}"
    },
    {
      "description": "Limit concurrent PRs to keep CI signal clear",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "prConcurrentLimit": 4
    },
    {
      "description": "Schedule weekly batch to avoid mid-day surprise PRs",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "schedule": ["before 06:00 on monday"]
    }
  ]
}
