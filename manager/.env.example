# Twinbox Manager Environment Configuration
# Copy this file to .env and fill in the values

# ==================== Database ====================
# PostgreSQL connection URL
# Format: postgresql+psycopg2://username:password@host:port/database
DATABASE_URL=postgresql+psycopg2://twinbox:your_password@localhost:5432/twinbox

# ==================== Redis ====================
# Redis URL for job queue/celery (optional)
REDIS_URL=redis://localhost:6379/0

# ==================== Security ====================
# Secret key for session encryption and JWT signing
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# ==================== Proxmox ====================
# Path to Proxmox credentials file (JSON)
# The file should contain: {"host": "...", "user": "...", "token": "...", "password": "..."}
PROXMOX_CREDENTIALS_PATH=/etc/twinbox/proxmox-credentials.json

# Alternative: Direct Proxmox credentials (overrides file if set)
PROXMOX_HOST=proxmox.example.com
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your_password
PROXMOX_TOKEN_NAME=your-token-name
PROXMOX_TOKEN_VALUE=your-token-secret

# ==================== Application ====================
# Application name
APP_NAME=Twinbox Manager

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==================== Email (Optional) ====================
# SMTP configuration for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@twinbox.local
SMTP_FROM_NAME=Twinbox

# ==================== Storage (Optional) ====================
# For storing large files, backups, etc.
LOCAL_STORAGE_PATH=/var/lib/twinbox/storage
MAX_UPLOAD_SIZE_MB=100

# ==================== Monitoring (Optional) ====================
# Prometheus metrics endpoint
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================== Worker Configuration ====================
# RQ/Celery configuration
WORKER_CONCURRENCY=4
WORKER_QUEUE_PREFIX=twinbox

# Job timeout settings (seconds)
JOB_TIMEOUT=3600
JOB_RESULT_TTL=86400
JOB_FAILURE_TTL=604800
