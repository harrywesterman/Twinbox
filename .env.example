PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
# Bootstrap secret only; the canonical copy lives under /opt/twinbox/bootstrap/secrets.
PROXMOX_PASSWORD=change-me
PROXMOX_NODE=pve
PROXMOX_STORAGE_POOL=local-lvm
PROXMOX_FILE_DATASTORE=local
PROXMOX_VERIFY_MAX_ATTEMPTS=24
TALOS_IMAGE_PRESET=qemu-guest-agent
TWINBOX_IMAGE_TAG=sha-a4275f4
TWINBOX_HOST_REPO_ROOT=/opt/twinbox
TWINBOX_SECRET_BACKEND=filesystem
TWINBOX_BOOTSTRAP_DIR=/opt/twinbox/bootstrap
TWINBOX_SECRET_ITEM_PREFIX=twinbox
TWINBOX_TIME_SERVER=time.cloudflare.com
MANAGEMENT_VM_IP=192.168.1.50
# Comma-separated CIDRs allowed to call manager-api:8080.
# Add the Kubernetes node or egress CIDR when it is not covered by the defaults.
MANAGER_API_TRUSTED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8
TWINBOX_SECRET_TEMP_DIR=/tmp/twinbox-secrets
TWINBOX_SECRET_CACHE_TTL_SEC=60
SEAWEEDFS_ACCESS_KEY_ID=velero
SEAWEEDFS_SECRET_ACCESS_KEY=change-me
SEAWEEDFS_BUCKET=twinbox-velero
SEAWEEDFS_REGION=seaweedfs
SEAWEEDFS_VOLUME_MAX=300

# Optional local GitOps promotion gate.
FORGEJO_VERSION=15.0.3
FORGEJO_HTTP_PORT=3001
FORGEJO_ROOT_URL=http://192.168.1.50:3001/
FORGEJO_ADMIN_USER=twinbox
FORGEJO_ADMIN_EMAIL=admin@twinbox.local
FORGEJO_ADMIN_PASSWORD=
TWINBOX_UPSTREAM_GIT_REPO_URL=https://github.com/harrywesterman/Twinbox.git
TWINBOX_FORGEJO_REPO_OWNER=twinbox
TWINBOX_FORGEJO_REPO_NAME=Twinbox
TWINBOX_FORGEJO_REPO_URL=http://192.168.1.50:3001/twinbox/Twinbox.git
