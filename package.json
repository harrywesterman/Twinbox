{
  "name": "twinbox-root",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint lib/ scripts/",
    "lint:fix": "eslint lib/ scripts/ --fix",
    "format": "prettier --write \"lib/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"lib/**/*.{js,mjs}\" \"scripts/**/*.{js,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.3"
  }
}
