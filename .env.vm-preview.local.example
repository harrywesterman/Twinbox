TWINBOX_VM_PREVIEW_TARGET=twinbox@<management-vm-ip>
TWINBOX_VM_PREVIEW_REMOTE_DIR=/opt/twinbox

# Optional: use this when the VM still uses password auth and you want the
# preview script to call sshpass automatically.
# TWINBOX_VM_PREVIEW_PASSWORD=replace-me

# Optional: set this if the VM .env uses a non-default TWINBOX_IMAGE_TAG.
# TWINBOX_VM_PREVIEW_IMAGE_TAG=latest

# Optional: change the temporary upload location on the Management VM.
# TWINBOX_VM_PREVIEW_REMOTE_TMP=/tmp/twinbox-manager-web-preview
