#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - jq
  - openssl
  - python3
  - python3-yaml
  - ufw

write_files:
  - path: /opt/netbird/.dns-credentials
    permissions: "0600"
    content: |
      DNS_API_TOKEN=${dns_api_token}
      DNS_API_SECRET=${dns_api_secret}
  - path: /opt/netbird/.bootstrap.env
    permissions: "0600"
    content: |
      NETBIRD_DOMAIN=${netbird_fqdn}
      ADMIN_EMAIL=${netbird_admin_email}
      NETBIRD_VERSION=${netbird_version}
      PROXY_DOMAIN=${netbird_proxy_domain}
      PUBLIC_ZONE_NAME=${public_zone_name}
      DNS_PROVIDER=${dns_provider}
      ADMIN_TOKEN_EXPIRE_DAYS=${admin_token_expire_days}
      OPKSSH_ISSUER_URL=${opkssh_issuer_url}
      OPKSSH_CLIENT_ID=${opkssh_client_id}
  - path: /root/bootstrap-netbird.sh
    permissions: "0700"
    content: |
      ${indent(6, netbird_bootstrap_script)}

runcmd:
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 3478/udp
  - ufw --force enable
%{ if opkssh_issuer_url != "" && opkssh_client_id != "" }
  - |
    set -euo pipefail
    curl -fsSL https://github.com/openpubkey/opkssh/releases/download/v0.14.0/opkssh-linux-amd64 -o /tmp/opkssh
    echo "972719cb6dae736af80100fee0854fdd7289f419fc61b3dcace8409b2f043063  /tmp/opkssh" | sha256sum -c -
    install -o root -g root -m 0755 /tmp/opkssh /usr/local/bin/opkssh
    rm -f /tmp/opkssh
    groupadd -r opksshuser || true
    useradd -r -g opksshuser -s /usr/sbin/nologin -d /var/lib/opksshuser -m opksshuser || true
    mkdir -p /etc/opk
    touch /var/log/opkssh.log
    chown root:opksshuser /var/log/opkssh.log
    chmod 0660 /var/log/opkssh.log
    cat > /etc/opk/providers <<EOF
    ${opkssh_issuer_url} ${opkssh_client_id} 24h
    EOF
    cat > /etc/opk/auth_id <<EOF
    root oidc:groups:admins ${opkssh_issuer_url}
    EOF
    chown -R root:opksshuser /etc/opk
    chmod 0750 /etc/opk
    chmod 0640 /etc/opk/providers /etc/opk/auth_id
    cat > /etc/ssh/sshd_config.d/60-opk-ssh.conf <<'SSHD'
    AuthorizedKeysCommand /usr/local/bin/opkssh verify %u %k %t
    AuthorizedKeysCommandUser opksshuser
    SSHD
    systemctl restart sshd || true
    /usr/local/bin/opkssh verify --help >/dev/null
    /usr/local/bin/opkssh audit || true
%{ endif }
  - /root/bootstrap-netbird.sh
