#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - jq
  - python3
  - python3-yaml
  - ufw

runcmd:
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 3478/udp
  - ufw --force enable
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable docker
  - systemctl start docker
